<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_launcher" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:accessibilityHeading="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="30sp"
            tools:targetApi="28" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/about_tagline"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/guide_card"
            android:padding="16dp"
            android:text="@string/about_free"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <LinearLayout
            style="@style/AboutRow"
            android:layout_marginTop="16dp">

            <LinearLayout style="@style/AboutRowTexts">

                <TextView
                    style="@style/AboutRowTitle"
                    android:text="@string/about_made_by" />

                <TextView
                    style="@style/AboutRowValue"
                    android:text="@string/about_author" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/source"
            style="@style/AboutRow"
            android:background="?android:attr/selectableItemBackground">

            <LinearLayout style="@style/AboutRowTexts">

                <TextView
                    style="@style/AboutRowTitle"
                    android:text="@string/about_source_title" />

                <TextView
                    style="@style/AboutRowValue"
                    android:text="@string/about_source" />
            </LinearLayout>

            <ImageView
                style="@style/AboutRowChevron"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/license"
            style="@style/AboutRow"
            android:background="?android:attr/selectableItemBackground">

            <LinearLayout style="@style/AboutRowTexts">

                <TextView
                    style="@style/AboutRowTitle"
                    android:text="@string/about_license_title" />

                <TextView
                    style="@style/AboutRowValue"
                    android:text="@string/about_license" />
            </LinearLayout>

            <ImageView
                style="@style/AboutRowChevron"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout style="@style/AboutRow">

            <LinearLayout style="@style/AboutRowTexts">

                <TextView
                    style="@style/AboutRowTitle"
                    android:text="@string/about_version_title" />

                <TextView
                    android:id="@+id/version"
                    style="@style/AboutRowValue" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
