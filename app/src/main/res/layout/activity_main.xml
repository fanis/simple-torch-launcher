<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/intro"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_status" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <Button
            android:id="@+id/open_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_accessibility_settings" />

        <TextView
            android:id="@+id/restricted_hint"
            style="@style/Note"
            android:text="@string/restricted_hint"
            android:visibility="gone" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_button" />

        <RadioGroup
            android:id="@+id/button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/volume_up"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/volume_up" />

            <RadioButton
                android:id="@+id/volume_down"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/volume_down" />
        </RadioGroup>

        <TextView
            style="@style/Note"
            android:text="@string/button_note" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/section_screen_off" />

        <Switch
            android:id="@+id/screen_off"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/screen_off"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            style="@style/Note"
            android:text="@string/screen_off_note" />

        <Button
            android:id="@+id/about"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about_title" />

    </LinearLayout>
</ScrollView>
